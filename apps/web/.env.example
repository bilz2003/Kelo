# Where the Kelo backend (apps/backend) is reachable FROM THE NEXT.JS SERVER.
# Server-side only — never exposed to the browser (no NEXT_PUBLIC_ prefix).
KELO_API_URL=http://localhost:3000

# Session cookies are always httpOnly + Secure + SameSite=Lax. Browsers treat
# http://localhost as a secure context and accept Secure cookies there, so no
# override is normally needed. Set to 1 ONLY if you're testing over plain
# http on a non-localhost host (e.g. a LAN IP), where browsers reject them.
# KELO_COOKIE_INSECURE=1
