{
  "expo": {
    "name": "Kelo",
    "slug": "kelo",
    "scheme": "kelo",
    "version": "0.1.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#12161C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kelo.app"
    },
    "android": {
      "package": "com.kelo.app",
      "adaptiveIcon": {
        "backgroundColor": "#12161C"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Kelo uses your photos to let you add pictures of your charger listing."
        }
      ],
      "expo-secure-store"
    ]
  }
}
