{
  "expo": {
    "name": "Kelo",
    "slug": "kelo",
    "scheme": "kelo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#12161C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kelo.app"
    },
    "android": {
      "package": "com.kelo.app",
      "adaptiveIcon": {
        "backgroundColor": "#12161C"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Kelo uses your photos to let you add pictures of your charger listing."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kelo uses your location to show how far away chargers are and sort Discover by distance.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "4e5d7919-9c2d-490c-984e-a63b6ab6804c"
      }
    },
    "owner": "validly"
  }
}
