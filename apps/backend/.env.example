# Copy to .env for local development.
PORT=3000

# Region the AWS infra was deployed to (see infrastructure/).
AWS_REGION=eu-west-2

# ARN of the Secrets Manager secret holding the generated RDS credentials —
# get this from `cdk deploy` output (DatabaseSecretArn) or the AWS console.
# When set, DATABASE_URL is derived from it automatically at boot (see
# src/config/load-database-secret.ts). Requires AWS credentials to be
# available (e.g. via `aws configure` / the default credential chain) —
# this app doesn't ship its own AWS access keys.
DATABASE_SECRET_ARN=

# apps/backend runs outside the VPC — RDS is only reachable through the SSM
# tunnel described in DATABASE.md. Set this to the tunnel's local port so
# load-database-secret.ts connects through it instead of the (unreachable
# from here) real RDS hostname. Leave unset only once the backend runs
# somewhere with direct network access to RDS.
DATABASE_TUNNEL_LOCAL_PORT=15432

# Signing secret for JWTs issued by /auth/login and /auth/register.
# Generate a real one for any non-local environment, e.g.: openssl rand -hex 32
JWT_SECRET=

# The Prisma CLI (migrate/generate/studio) reads this directly from .env —
# unlike the Nest app, it does not run load-database-secret.ts. Point it at
# the SSM tunnel's local port with the real RDS credentials (from the same
# secret as DATABASE_SECRET_ARN above), e.g.:
# postgresql://kelo_app:<password>@localhost:15432/kelo
DATABASE_URL=
